generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://neondb_owner:npg_mbt2SVugy8jk@ep-shy-thunder-ade199gr-pooler.c-2.us-east-1.aws.neon.tech:5432/neondb?sslmode=require&channel_binding=require"
}

model datasets {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  upload_date DateTime? @db.Date
  status      String?   @db.VarChar(50)
  data_type   String?   @db.VarChar(100)
  file_format String?   @db.VarChar(50)
  tags        String?
}

model interviewers {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String      @unique
  full_name String?
  responses responses[]
}

model responses {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  study_id       String        @db.Uuid
  respondent_id  String?
  interviewer_id String?       @db.Uuid
  dataset_id     Int?
  status         String?
  is_complete    Boolean       @default(false)
  duration_sec   Int?
  start_time     DateTime?     @db.Timestamptz(6)
  end_time       DateTime?     @db.Timestamptz(6)
  start_date     DateTime?     @db.Date
  start_hour     Int?
  region         String?
  source_file    String
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  interviewers   interviewers? @relation(fields: [interviewer_id], references: [id], onUpdate: NoAction)
  studies        studies       @relation(fields: [study_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_complete], map: "ix_resp_complete")
  @@index([interviewer_id], map: "ix_resp_interviewer")
  @@index([study_id, start_date, start_hour], map: "ix_resp_study_time")
}

model studies {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String      @unique
  title      String?
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  responses  responses[]
}

model interviewers {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String      @unique
  full_name String?
  responses responses[]
}

model responses {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  study_id       String        @db.Uuid
  respondent_id  String?
  interviewer_id String?       @db.Uuid
  status         String?
  is_complete    Boolean       @default(false)
  duration_sec   Int?
  start_time     DateTime?     @db.Timestamptz(6)
  end_time       DateTime?     @db.Timestamptz(6)
  start_date     DateTime?     @db.Date
  start_hour     Int?
  region         String?
  source_file    String
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  interviewers   interviewers? @relation(fields: [interviewer_id], references: [id], onUpdate: NoAction)
  studies        studies       @relation(fields: [study_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_complete], map: "ix_resp_complete")
  @@index([interviewer_id], map: "ix_resp_interviewer")
  @@index([study_id, start_date, start_hour], map: "ix_resp_study_time")
}

model studies {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String      @unique
  title      String?
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  responses  responses[]
}
